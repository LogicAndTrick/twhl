{
	"name": "laravel/laravel",
	"description": "The Laravel Framework.",
	"keywords": ["framework", "laravel"],
	"license": "MIT",
	"type": "project",
	"require": {
		"ext-gd": "*",
		"laravel/framework": "^13.0",
		"laravel/ui": "^4.6",
		"logicandtrick/laravel-recaptcha": "^6.2",
		"logicandtrick/wikicodeparser": "^0.9.9",
		"monicahq/laravel-cloudflare": "^4.1",
		"sentry/sentry-laravel": "^4.20"
	},
	"require-dev": {
		"barryvdh/laravel-ide-helper": "^3.7",
		"nunomaduro/collision": "^8.9",
		"phpunit/phpunit": "^13.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		 "psr-4": {
			 "Tests\\": "tests/"
		 }
	 },
	"scripts": {
		"post-install-cmd": [
			"php artisan clear-compiled"
		],
		"post-update-cmd": [
			"php artisan clear-compiled"
		],
		"post-create-project-cmd": [
			"php -r \"copy('.env.example', '.env');\"",
			"php artisan key:generate"
		]
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "logicandtrick/wikicodeparser",
				"version": "0.9.10",
				"dist": {
					"url": "https://github.com/LogicAndTrick/WikiCodeParser/releases/download/v0.9.10/wikicodeparser-php.zip",
					"type": "zip"
				},
				"autoload": {
					"classmap": ["src/"]
				}
			}
		},
		{
			"type": "vcs",
			"url": "https://github.com/LogicAndTrick/laravel-recaptcha"
		}
	]
}
